{
  "uid": "hunter",
  "title": "PostgreSQL investigation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Collection available",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hunter_postgres_up",
          "legendFormat": "{{__name__}} {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Oldest active query (not API latency)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hunter_oldest_query_seconds",
          "legendFormat": "{{__name__}} {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Active sessions / Lock waits",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hunter_active_sessions",
          "legendFormat": "{{__name__}} {{status}}"
        },
        {
          "refId": "B",
          "expr": "hunter_lock_waiters",
          "legendFormat": "Lock waits"
        }
      ]
    },
    {
      "id": 4,
      "title": "Transactions / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hunter_transactions_total[1m])",
          "legendFormat": "{{__name__}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "PostgreSQL buffer cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hunter_blocks_total{source=\"hit\"}[1m])) / clamp_min(sum(rate(hunter_blocks_total[1m])), 0.000001)",
          "legendFormat": "{{__name__}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Temporary bytes / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(hunter_temp_bytes_total[1m])",
          "legendFormat": "{{__name__}} {{status}}"
        }
      ]
    }
  ],
  "tags": [
    "postgresql",
    "hunter"
  ],
  "timezone": "browser"
}
