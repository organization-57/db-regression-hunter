DATABASE_URL=postgres://hunter:hunter@postgres:5432/demo?sslmode=disable
HTTP_ADDR=:8080
POLL_INTERVAL=10s
BASELINE_SAMPLES=20
DEGRADATION_FACTOR=3
CONFIRM_SAMPLES=3
SQL_STATS_ENABLED=true
SQL_MIN_CALLS=5
SQL_MIN_INCREASE_MS=5
RECOVERY_SAMPLES=3
# Optional: both values are required to enable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GRAFANA_URL=http://localhost:3000/d/hunter/postgresql-investigation
GRAFANA_ADMIN_PASSWORD=local-demo-password
# Demo: empty timings are derived from detector settings.
DEMO_WARMUP=
DEMO_INCIDENT_DURATION=
DEMO_COOLDOWN=3m
# Scenarios are shuffled each round. Set a subset to focus the demo.
DEMO_SCENARIOS=row_lock,slow_report,table_lock,lock_chain,temp_spill,session_burst,deadlock
